{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blender YOLO Dataset Generator Configuration",
  "description": "Configuration schema for generating YOLO training datasets with BlenderProc",
  "type": "object",
  "required": [
    "models_path",
    "output",
    "dataset"
  ],
  "properties": {
    "seed": {
      "type": "object",
      "description": "Random seeds for reproducibility",
      "properties": {
        "numpy": {
          "type": "integer",
          "description": "Seed for NumPy random functions"
        },
        "blenderproc": {
          "type": "string",
          "description": "Seed for BlenderProc"
        }
      }
    },
    "models_path": {
      "type": "string",
      "description": "Path to directory containing 3D models. Each subdirectory represents one class."
    },
    "cc_textures_path": {
      "type": "string",
      "description": "Path to CC0 textures directory (downloaded via blenderproc download cc_textures)"
    },
    "camera": {
      "type": "object",
      "description": "Camera intrinsic parameters",
      "properties": {
        "px": {
          "type": "number",
          "description": "Focal length in pixels (x-axis)",
          "default": 600
        },
        "py": {
          "type": "number",
          "description": "Focal length in pixels (y-axis)",
          "default": 600
        },
        "u0": {
          "type": "number",
          "description": "Principal point x-coordinate",
          "default": 320
        },
        "v0": {
          "type": "number",
          "description": "Principal point y-coordinate",
          "default": 240
        },
        "width": {
          "type": "integer",
          "description": "Image width in pixels",
          "minimum": 1,
          "default": 640
        },
        "height": {
          "type": "integer",
          "description": "Image height in pixels",
          "minimum": 1,
          "default": 480
        },
        "randomize_params_percent": {
          "type": "number",
          "description": "Percentage to randomize camera parameters (0-100)",
          "minimum": 0,
          "maximum": 100,
          "default": 5.0
        }
      },
      "required": [
        "px",
        "py",
        "u0",
        "v0",
        "width",
        "height"
      ]
    },
    "rendering": {
      "type": "object",
      "description": "Rendering quality settings",
      "properties": {
        "max_samples": {
          "type": "integer",
          "description": "Number of rays per pixel (higher = better quality, slower)",
          "minimum": 1,
          "default": 32
        },
        "denoiser": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "INTEL",
            "OPTIX",
            "OPENIMAGEDENOISE"
          ],
          "description": "Denoiser to use. OPTIX requires compatible Nvidia GPU",
          "default": "OPTIX"
        }
      }
    },
    "scene": {
      "type": "object",
      "description": "Scene generation parameters",
      "properties": {
        "room_size_multiplier_min": {
          "type": "number",
          "description": "Minimum room size as factor of largest object",
          "minimum": 1.0,
          "default": 5.0
        },
        "room_size_multiplier_max": {
          "type": "number",
          "description": "Maximum room size relative to max object size",
          "minimum": 2.0,
          "default": 10.0
        },
        "room_min_width": {
          "type": "number",
          "description": "Optional explicit minimum width of the room (X axis)",
          "minimum": 1.0
        },
        "room_max_width": {
          "type": "number",
          "description": "Optional explicit maximum width of the room (X axis)",
          "minimum": 1.0
        },
        "room_min_length": {
          "type": "number",
          "description": "Optional explicit minimum length of the room (Y axis)",
          "minimum": 1.0
        },
        "room_max_length": {
          "type": "number",
          "description": "Optional explicit maximum length of the room (Y axis)",
          "minimum": 1.0
        },
        "room_min_height": {
          "type": "number",
          "description": "Optional explicit minimum height of the room (Z axis)",
          "minimum": 1.0
        },
        "room_max_height": {
          "type": "number",
          "description": "Optional explicit maximum height of the room (Z axis)",
          "minimum": 1.0
        },
        "simulate_physics": {
          "type": "boolean",
          "description": "Enable physics simulation (objects fall to ground)",
          "default": false
        },
        "max_textures": {
          "type": "integer",
          "description": "Maximum number of textures to load per run",
          "minimum": 1,
          "default": 50
        },
        "ambient_strength": {
          "type": "number",
          "description": "Strength of global ambient background light (0-1). Prevents pitch-black shadows.",
          "minimum": 0.0,
          "maximum": 5.0,
          "default": 0.5
        },
        "debug_initial_state": {
          "type": "boolean",
          "description": "If true, saves a debug image of the scene before physics simulation.",
          "default": false
        },
        "distractors": {
          "type": "object",
          "description": "Distractor objects settings",
          "properties": {
            "min_count": {
              "type": "integer",
              "minimum": 0,
              "default": 20
            },
            "max_count": {
              "type": "integer",
              "minimum": 0,
              "default": 50
            },
            "min_size_rel_scene": {
              "type": "number",
              "description": "Minimum distractor size relative to room size",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.05
            },
            "max_size_rel_scene": {
              "type": "number",
              "description": "Maximum distractor size relative to room size",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.1
            },
            "displacement_max": {
              "type": "number",
              "description": "Maximum displacement amount (0 = disabled, warning: slow)",
              "minimum": 0.0,
              "default": 0.0
            },
            "pbr_noise": {
              "type": "number",
              "description": "Noise to add to PBR material properties",
              "minimum": 0.0,
              "default": 0.5
            },
            "emissive_prob": {
              "type": "number",
              "description": "Probability that distractor becomes light source",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.0
            },
            "emissive_strength_min": {
              "type": "number",
              "minimum": 0.0,
              "default": 2.0
            },
            "emissive_strength_max": {
              "type": "number",
              "minimum": 0.0,
              "default": 5.0
            },
            "min_rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Minimum Euler rotation in degrees [x, y, z] for distractors"
            },
            "max_rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Maximum Euler rotation in degrees [x, y, z] for distractors"
            },
            "place_on_ground": {
              "type": "boolean",
              "description": "Whether to place distractors firmly on the floor",
              "default": false
            },
            "texture_blacklist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of texture folder names to exclude for floor and distractor objects"
            },
            "min_size": {
              "type": "number",
              "description": "Explicit minimum absolute size (overrides rel_scene)",
              "minimum": 0.0
            },
            "max_size": {
              "type": "number",
              "description": "Explicit maximum absolute size (overrides rel_scene)",
              "minimum": 0.0
            }
          }
        },
        "lights": {
          "type": "object",
          "description": "Lighting settings",
          "properties": {
            "min_count": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            },
            "max_count": {
              "type": "integer",
              "minimum": 0,
              "default": 6
            },
            "min_intensity": {
              "type": "number",
              "minimum": 0,
              "default": 50
            },
            "max_intensity": {
              "type": "number",
              "minimum": 0,
              "default": 200
            }
          }
        },
        "objects": {
          "type": "object",
          "description": "Target object settings",
          "properties": {
            "min_count": {
              "type": "integer",
              "description": "Minimum number of target objects per scene",
              "minimum": 1,
              "default": 2
            },
            "max_count": {
              "type": "integer",
              "description": "Maximum number of target objects per scene",
              "minimum": 1,
              "default": 5
            },
            "multiple_occurrences": {
              "type": "boolean",
              "description": "Allow same object class multiple times in scene",
              "default": true
            },
            "scale_noise": {
              "type": "number",
              "description": "Amount of scale randomization (0-1)",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.2
            },
            "displacement_max": {
              "type": "number",
              "description": "Maximum displacement for geometry variation",
              "minimum": 0.0,
              "default": 0.0
            },
            "pbr_noise": {
              "type": "number",
              "description": "Noise to add to object material properties",
              "minimum": 0.0,
              "default": 0.3
            },
            "cam_min_dist_rel": {
              "type": "number",
              "description": "Minimum camera distance relative to object size",
              "minimum": 0.1,
              "default": 1.0
            },
            "cam_max_dist_rel": {
              "type": "number",
              "description": "Maximum camera distance relative to object size",
              "minimum": 0.1,
              "default": 3.0
            },
            "cam_min_elev_deg": {
              "type": "number",
              "description": "Minimum camera elevation angle in degrees (0 = horizontal)",
              "default": 0.0
            },
            "cam_max_elev_deg": {
              "type": "number",
              "description": "Maximum camera elevation angle in degrees (90 = straight down)",
              "default": 90.0
            },
            "cam_min_roll_deg": {
              "type": "number",
              "description": "Minimum camera roll angle in degrees (0 = laying flat relative to room)",
              "default": 0.0
            },
            "cam_max_roll_deg": {
              "type": "number",
              "description": "Maximum camera roll angle in degrees",
              "default": 360.0
            },
            "cam_min_pitch_deg": {
              "type": "number",
              "description": "Minimum camera pitch offset in degrees (0 = looking directly at object)",
              "default": 0.0
            },
            "cam_max_pitch_deg": {
              "type": "number",
              "description": "Maximum camera pitch offset in degrees",
              "default": 0.0
            },
            "cam_min_yaw_deg": {
              "type": "number",
              "description": "Minimum camera yaw offset in degrees (0 = looking directly at object)",
              "default": 0.0
            },
            "cam_max_yaw_deg": {
              "type": "number",
              "description": "Maximum camera yaw offset in degrees",
              "default": 0.0
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "class_id": {
                "type": "integer",
                "minimum": 0,
                "description": "Numeric class ID for YOLO training (allows grouping multiple models under the same class index)"
              },
              "class_name": {
                "type": "string",
                "description": "Training class name/label for YOLO data.yaml and classes.txt"
              },
              "texture": {
                "type": "string"
              },
              "textures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "randomize_materials": {
                "type": "boolean",
                "description": "Whether to apply random CC materials and base color fallbacks to this object",
                "default": true
              },
              "initial_rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "Initial Euler rotation in degrees [x, y, z] before physics drop"
              },
              "min_rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "Minimum Euler rotation in degrees [x, y, z]"
              },
              "max_rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "Maximum Euler rotation in degrees [x, y, z]"
              },
              "initial_height": {
                "type": "number",
                "description": "Initial Z-coordinate (height) of the object before physics drop"
              }
            }
          }
        },
        "custom_distractors": {
          "type": "object",
          "description": "Configuration for custom 3D model distractors",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "description": "Path to directory containing custom distractor models (.obj, .blend)"
            },
            "min_count": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "max_count": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "min_size_rel_scene": {
              "type": "number",
              "minimum": 0.0,
              "default": 0.05
            },
            "max_size_rel_scene": {
              "type": "number",
              "minimum": 0.0,
              "default": 0.1
            },
            "min_rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Minimum Euler rotation in degrees [x, y, z]"
            },
            "max_rotation": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Maximum Euler rotation in degrees [x, y, z]"
            },
            "place_on_ground": {
              "type": "boolean",
              "description": "Whether to place custom distractors firmly on the floor",
              "default": false
            },
            "folder_name": {
              "type": [
                "string",
                "null"
              ],
              "description": "Folder name relative to models_path containing custom distractor models"
            },
            "min_size": {
              "type": "number",
              "description": "Explicit minimum absolute size (overrides rel_scene)",
              "minimum": 0.0
            },
            "max_size": {
              "type": "number",
              "description": "Explicit maximum absolute size (overrides rel_scene)",
              "minimum": 0.0
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "description": "Dataset generation and output settings",
      "required": [
        "num_scenes",
        "images_per_scene"
      ],
      "properties": {
        "num_scenes": {
          "type": "integer",
          "description": "Total number of scenes to generate",
          "minimum": 1
        },
        "scenes_per_run": {
          "type": "integer",
          "description": "Number of scenes to generate per BlenderProc run",
          "minimum": 1,
          "default": 1
        },
        "images_per_scene": {
          "type": "integer",
          "description": "Number of images to render per scene",
          "minimum": 1
        },
        "empty_images_per_scene": {
          "type": "integer",
          "description": "Number of images without target objects (negative examples)",
          "minimum": 0,
          "default": 0
        },
        "train_split": {
          "type": "number",
          "description": "Fraction of data for training",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.7
        },
        "val_split": {
          "type": "number",
          "description": "Fraction of data for validation",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.2
        },
        "test_split": {
          "type": "number",
          "description": "Fraction of data for testing",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.1
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Output format and paths",
      "required": [
        "save_path",
        "yolo_format"
      ],
      "properties": {
        "save_path": {
          "type": "string",
          "description": "Path to save generated dataset"
        },
        "yolo_format": {
          "type": "string",
          "enum": [
            "yolov11",
            "yolov26",
            "yolov11-obb",
            "yolov26-obb"
          ],
          "description": "YOLO format: yolov11/yolov26 (standard bbox) or yolov11-obb/yolov26-obb (oriented bbox)"
        },
        "save_depth": {
          "type": "boolean",
          "description": "Save depth maps",
          "default": false
        },
        "save_normals": {
          "type": "boolean",
          "description": "Save surface normals",
          "default": false
        },
        "save_segmentation": {
          "type": "boolean",
          "description": "Save segmentation masks",
          "default": false
        },
        "save_pose": {
          "type": "boolean",
          "description": "Save 6D object poses",
          "default": false
        },
        "detection_params": {
          "type": "object",
          "description": "Object detection annotation parameters",
          "properties": {
            "min_bbox_side_px": {
              "type": "number",
              "description": "Minimum bounding box side size in pixels",
              "minimum": 1,
              "default": 10
            },
            "min_visibility": {
              "type": "number",
              "description": "Minimum visibility percentage (0-1). Objects with visibility below this due to occlusion will be discarded.",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.3
            },
            "force_fully_visible": {
              "type": "boolean",
              "description": "If true, objects that are partially outside the image boundaries will be discarded.",
              "default": false
            },
            "occlusion_samples": {
              "type": "integer",
              "description": "Number of points to sample for occlusion detection",
              "minimum": 1,
              "default": 100
            }
          }
        }
      }
    }
  }
}